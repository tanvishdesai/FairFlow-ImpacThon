\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CODA v2 dynamics on Adult (XGBoost, seed 42). (a) Per-group threshold trajectories showing asymmetric adaptation. (b) Dual variable $\lambda (t)$ evolution showing active constraint enforcement. (c) Rolling DPR comparison: CODA (teal) achieves consistently higher DPR than Group Threshold (dark) and Base Model (grey). (d) Rolling intervention rate confirming efficient, targeted corrections.}}{8}{figure.caption.16}\protected@file@percent }
\newlabel{fig:dynamics_adult}{{1}{8}{CODA v2 dynamics on Adult (XGBoost, seed 42). (a) Per-group threshold trajectories showing asymmetric adaptation. (b) Dual variable $\lambda (t)$ evolution showing active constraint enforcement. (c) Rolling DPR comparison: CODA (teal) achieves consistently higher DPR than Group Threshold (dark) and Base Model (grey). (d) Rolling intervention rate confirming efficient, targeted corrections}{figure.caption.16}{}}
